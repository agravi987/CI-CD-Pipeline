# =============================================================================
# .env.example — a SAMPLE of the secrets/config this app needs
# =============================================================================
# 🧠 HOW THIS WORKS (plain English):
#   Docker Compose reads a file called `.env` and fills in every ${NAME}
#   placeholder in the compose files. This example shows you WHAT to put there.
#
#   📋 WHAT TO DO:
#     1. Copy this file:   Copy-Item .env.example .env
#     2. Change the passwords to something you invent (no real secrets here!)
#     3. NEVER commit your .env  (it's already in .gitignore)
#
# LINE-BY-LINE: read the `#` comments below.
# =============================================================================

# ---- PostgreSQL (used by the `db` service at first boot) ----
POSTGRES_USER=appuser              # the database admin username
POSTGRES_PASSWORD=change_me_please # ⚠️ change this to a real password
POSTGRES_DB=appdb                  # the name of the database

# ---- Backend (used by the Express app to connect to Postgres) ----
DB_HOST=db                         # 'db' = the compose service name (a DNS name inside Docker)
DB_PORT=5432                       # Postgres's default port
DB_NAME=appdb                      # must match POSTGRES_DB above
DB_USER=appuser                    # must match POSTGRES_USER above
DB_PASSWORD=change_me_please       # must match POSTGRES_PASSWORD above